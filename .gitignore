# Secrets and local env
.env
.env.local
*.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Tool caches. pytest and ruff run from the repo root, so their caches land here
# rather than inside the subproject whose own .gitignore already covers them.
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
.~lock.*

# Helm dependency tarballs: reproducible from charts/platform-bootstrap/Chart.lock
# by `helm dependency build`, so the lock is tracked and the payload is not.
charts/platform-bootstrap/charts/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
# Plan artifacts: binary, can contain rendered secrets, meaningless after state change.
terraform/tfplan
terraform/tfplan*
*.tfplan

# Local-only documentation and learning artifacts.
# Personal notes, progress logs, drill material, and roadmap docs
# are kept locally and not version controlled.
PROGRESS.md
docs/

# Drafts and diffs handed over in working sessions. Scratch, not source: anything
# worth keeping is typed into the tree where it belongs.
Claude outputs/
