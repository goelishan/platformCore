# Copy to oncall/.env and adjust. .env is gitignored; this file is the documented shape.
#
# Defaults in config.py already match the dev compose stack, so nothing here is
# required for local work. It exists to show what production overrides look like.

# ---- cluster ---------------------------------------------------------------
ONCALL_CLUSTER=kind

# Empty means every namespace. The agent's own namespace is always excluded in code.
# ONCALL_NAMESPACES=oncall-lab,platformcore

# ---- store -----------------------------------------------------------------
# Dev: the compose stack on port 5433.
ONCALL_STORE_HOST=localhost
ONCALL_STORE_PORT=5433
ONCALL_STORE_DB=oncall
ONCALL_STORE_USER=oncall
ONCALL_STORE_PASSWORD=oncall
ONCALL_STORE_SSLMODE=prefer

# Production on RDS: sslmode becomes mandatory, and the password is an IAM auth token
# generated per connection rather than a stored secret — the same mechanism the
# FastAPI workload already uses.
#
# ONCALL_STORE_HOST=platformcore-db.abc123.us-east-1.rds.amazonaws.com
# ONCALL_STORE_PORT=5432
# ONCALL_STORE_SSLMODE=require
#
# A whole DSN can be supplied instead, which is what a Kubernetes Secret or an
# operator-provisioned database will hand over:
# ONCALL_STORE_DSN=postgresql://user:pass@host:5432/oncall?sslmode=require

# ---- buffer ----------------------------------------------------------------
# How long an outage the agent can absorb, and the hard ceiling that stops the buffer
# filling the volume the agent is running on.
# ONCALL_BUFFER_RETENTION_HOURS=48
# ONCALL_BUFFER_MAX_BYTES=536870912

# ---- cadence ---------------------------------------------------------------
# ONCALL_SHIP_INTERVAL=120
# ONCALL_SHIP_BATCH_SIZE=1000
