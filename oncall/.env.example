# Copy to oncall/.env and adjust. .env is gitignored; this file is the documented shape.
#
# config.py reads oncall/.env itself, ONCALL_* keys only, and never overrides the real
# environment. Code carries no working credential and fails closed: the default TLS
# mode is verify-full and there is no default password. Dev loosens both here.

# ---- environment -------------------------------------------------------------
# dev or prod. prod refuses to start unless the store uses verify-full TLS, an RDS CA
# bundle, IAM auth and no static password, and an AWS region is set.
ONCALL_ENV=dev

# ---- cluster -----------------------------------------------------------------
ONCALL_CLUSTER=kind-oncall

# Required outside the cluster. The collector never uses whichever context kubectl was
# last switched to. Inside the cluster the service account is used and this is ignored.
ONCALL_KUBE_CONTEXT=kind-oncall

# Empty means every namespace. The agent's own namespace is always excluded in code.
# ONCALL_NAMESPACES=oncall-lab,platformcore

# ---- store: dev (oncall/dev/compose.yaml, loopback on 5433) -------------------
ONCALL_STORE_HOST=127.0.0.1
ONCALL_STORE_PORT=5433
ONCALL_STORE_DB=oncall
ONCALL_STORE_USER=oncall
# Matches POSTGRES_PASSWORD in dev/compose.yaml. Dev only; prod refuses a password.
ONCALL_STORE_PASSWORD=change-me-dev-only
# The dev container serves no TLS. Never use disable anywhere but loopback.
ONCALL_STORE_SSLMODE=disable

# ---- store: prod (RDS) -------------------------------------------------------
# No password: an IAM auth token is generated for every connection from the pod's
# IRSA role, which needs rds-db:connect on this database user only.
#
# ONCALL_ENV=prod
# ONCALL_STORE_HOST=<rds-endpoint>
# ONCALL_STORE_PORT=5432
# ONCALL_STORE_USER=oncall
# ONCALL_STORE_SSLMODE=verify-full
# ONCALL_STORE_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem
# ONCALL_STORE_IAM_AUTH=true
# ONCALL_AWS_REGION=us-east-1

# ---- model: Amazon Bedrock (used from M5) ------------------------------------
# No key variable exists. Credentials come from the default AWS chain: IRSA in the
# cluster, an SSO session or named profile locally (aws sso login, AWS_PROFILE).
#
# ONCALL_BEDROCK_REGION=us-east-1
# An inference profile ID or ARN for the Claude model enabled in the account.
# ONCALL_BEDROCK_MODEL_ID=<inference-profile-id>
# Optional second layer of filtering; never a replacement for the agent's redaction.
# ONCALL_BEDROCK_GUARDRAIL_ID=<guardrail-id>
# ONCALL_BEDROCK_GUARDRAIL_VERSION=1
# ONCALL_BEDROCK_READ_TIMEOUT=90
# ONCALL_BEDROCK_MAX_TOKENS=2000

# ---- evidence ----------------------------------------------------------------
# Ceiling on the rendered bundle in bytes; lowest-ranked findings are dropped to fit
# and listed as omitted.
# ONCALL_PROMPT_MAX_BYTES=122880

# ---- buffer ------------------------------------------------------------------
# ONCALL_BUFFER_RETENTION_HOURS=48
# ONCALL_BUFFER_MAX_BYTES=536870912

# ---- cadence -----------------------------------------------------------------
# ONCALL_SHIP_INTERVAL=120
# ONCALL_SHIP_BATCH_SIZE=1000
